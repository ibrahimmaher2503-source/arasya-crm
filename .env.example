APP_NAME="My Arasya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Preliminary local tests only; SQLite in memory is not a production-engine decision.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
